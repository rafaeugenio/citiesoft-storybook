{
  "criterio": {
    "fundacao": "Decisão visual ou sistêmica consumida pelos componentes. Não é componente.",
    "atomo": "Peça indivisível que representa um único elemento de interface. Não depende de outro componente do catálogo, ou depende apenas por composição opcional de slot.",
    "molecula": "Resolve uma tarefa única e reconhecível combinando átomos. Inclui todo campo completo (rótulo, controle, ajuda e erro), porque no código isso é uma composição sobre o primitivo Field.",
    "organismo": "Seção autônoma com responsabilidade funcional própria, estado complexo ou dado tabular. Compõe moléculas e átomos.",
    "template": "Estrutura de tela sem conteúdo de domínio: regiões, hierarquia, responsividade e slots.",
    "pagina": "Instância de um template com conteúdo e estado realistas do domínio B2G."
  },
  "desvios_do_mapa_sugerido": [
    {
      "item": "Input, Textarea, Select",
      "sugerido": "átomo",
      "adotado": "molécula",
      "motivo": "No código, os três compõem o FieldWrapper (rótulo, obrigatório, helper, erro com ícone). Não são indivisíveis: são campo completo, que o próprio mapa do prompt classifica como molécula."
    },
    {
      "item": "Tooltip e Popover",
      "sugerido": "molécula",
      "adotado": "molécula",
      "motivo": "Sem dependência de catálogo, mas o papel é composição de gatilho mais painel ancorado, com uma tarefa única."
    },
    {
      "item": "Avatar e AvatarGroup",
      "sugerido": "átomo",
      "adotado": "Avatar átomo, AvatarGroup molécula",
      "motivo": "Avatar é indivisível. O grupo empilha Avatares e resolve a tarefa de mostrar co-responsáveis, com contador de excedente."
    },
    {
      "item": "Skeleton",
      "sugerido": "átomo",
      "adotado": "Skeleton átomo, composições molécula",
      "motivo": "O bloco é indivisível; SkeletonParagrafo, SkeletonLista e SkeletonFormulario montam padrões a partir dele."
    },
    {
      "item": "MeterGroup",
      "sugerido": "organismo",
      "adotado": "molécula",
      "motivo": "Resolve uma tarefa única (distribuição proporcional com legenda) e depende só da paleta categórica, não de estado complexo."
    },
    {
      "item": "Fieldset",
      "sugerido": "organismo",
      "adotado": "organismo",
      "motivo": "É seção de formulário com agrupamento semântico e colapso, não um campo."
    },
    {
      "item": "Menu",
      "sugerido": "organismo",
      "adotado": "organismo",
      "motivo": "Padrão ARIA de menu com roving tabindex e gestão de foco, responsabilidade funcional própria."
    }
  ],
