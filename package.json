{
  "name": "citiesoft-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook --run",
    "verificar-catalogo": "node scripts/verificar-catalogo.mjs",
    "gerar-inventario": "node scripts/gerar-inventario.mjs",
    "test-storybook:dark": "VITE_CITIE_TEMA_PADRAO=dark vitest --project=storybook --run",
    "gate": "npm run lint && tsc -b --force && npm run build-storybook && npm run test-storybook && npm run test-storybook:dark",
    "gerar-tokens": "node scripts/gerar-tokens.mjs",
    "gerar-icones": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.151",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.147",
    "motion": "^12.43.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "storybook": "^10.5.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest"
  }
}
